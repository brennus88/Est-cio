### `data/repository/LibraryRepository.kt`
```kotlin
package com.condominio.biblioteca.data.repository

import com.condominio.biblioteca.data.local.BookDao
import com.condominio.biblioteca.data.local.LoanDao
import com.condominio.biblioteca.data.local.ResidentDao
import com.condominio.biblioteca.data.model.Book
import com.condominio.biblioteca.data.model.Loan
import com.condominio.biblioteca.data.model.Resident
import kotlinx.coroutines.flow.Flow
import java.time.LocalDate

class LibraryRepository(
    private val bookDao: BookDao,
    private val residentDao: ResidentDao,
    private val loanDao: LoanDao
) {
    // Books
    fun getBooks(): Flow<List<Book>> = bookDao.getAll()
    fun searchBooks(query: String): Flow<List<Book>> = bookDao.search(query)
    suspend fun getBook(id: Long): Book? = bookDao.getById(id)
    suspend fun addOrUpdate(book: Book): Long = bookDao.insert(book)
    suspend fun delete(book: Book) = bookDao.delete(book)
    suspend fun setAvailability(bookId: Long, available: Boolean) = bookDao.setAvailability(bookId, available)

    // Residents
    fun getResidents(): Flow<List<Resident>> = residentDao.getAll()
    suspend fun addOrUpdate(resident: Resident): Long = residentDao.insert(resident)
    suspend fun delete(resident: Resident) = residentDao.delete(resident)

    // Loans
    fun getLoans(): Flow<List<Loan>> = loanDao.getAll()
    fun getOpenLoans(): Flow<List<Loan>> = loanDao.getOpenLoans()
    suspend fun newLoan(bookId: Long, residentId: Long, days: Int = 14): Long {
        val today = LocalDate.now()
        val due = today.plusDays(days.toLong())
        val id = loanDao.insert(Loan(bookId = bookId, residentId = residentId, loanDate = today, dueDate = due))
        bookDao.setAvailability(bookId, false)
        return id
    }
    suspend fun returnLoan(loanId: Long, bookId: Long) {
        val today = LocalDate.now()
        loanDao.closeLoan(loanId, today)
        bookDao.setAvailability(bookId, true)
    }
}
