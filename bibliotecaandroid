@Composable
fun LoanScreen() {
    val app = LocalApp()
    val booksVm: BookViewModel = viewModel(factory = ViewModelFactory(app.repository))
    val residentsVm: ResidentViewModel = viewModel(factory = ViewModelFactory(app.repository))
    val loansVm: LoanViewModel = viewModel(factory = ViewModelFactory(app.repository))

    val books by booksVm.books.collectAsState()
    val residents by residentsVm.residents.collectAsState()
    val openLoans by loansVm.openLoans.collectAsState()

    var selectedBook: Book? by remember { mutableStateOf(null) }
    var selectedResident: Resident? by remember { mutableStateOf(null) }

    Scaffold(topBar = { TopAppBar(title = { Text("Empréstimos") }) }) { padding ->
        Column(Modifier.padding(padding).padding(16.dp)) {
            Text("Novo empréstimo", style = MaterialTheme.typography.titleMedium)
            Spacer(Modifier.height(8.dp))
            Dropdown("Livro disponível", books.filter { it.available }) { selectedBook = it }
            Spacer(Modifier.height(8.dp))
            Dropdown("Morador", residents) { selectedResident = it }
            Spacer(Modifier.height(8.dp))
            Button(onClick = {
                val b = selectedBook; val r = selectedResident
                if (b != null && r != null) loansVm.newLoan(b.id, r.id)
            }) { Text("Emprestar") }
            Spacer(Modifier.height(16.dp))
            Text("Empréstimos em aberto", style = MaterialTheme.typography.titleMedium)
            LazyColumn {
                items(openLoans) { loan ->
                    ListItem(headlineContent = { Text("Empréstimo #${loan.id}") }, supportingContent = {
                        Text("Livro ID: ${loan.bookId} · Morador ID: ${loan.residentId} · Prev.: ${loan.dueDate}")
                    }, trailingContent = {
                        Button(onClick = { loansVm.returnLoan(loan.id, loan.bookId) }) { Text("Devolver") }
                    })
                    Divider()
                }
            }
        }
    }
}

@Composable
private fun <T> Dropdown(label: String, items: List<T>, onSelect: (T) -> Unit) {
    var expanded by remember { mutableStateOf(false) }
    var selectedText by remember { mutableStateOf("") }
    Column {
        OutlinedTextField(
            value = selectedText,
            onValueChange = {},
            readOnly = true,
            label = { Text(label) },
            modifier = Modifier.fillMaxWidth(),
            trailingIcon = { TextButton(onClick = { expanded = true }) { Text("Selecionar") } }
        )
        DropdownMenu(expanded = expanded, onDismissRequest = { expanded = false }) {
            items.forEach { item ->
                DropdownMenuItem(text = { Text(item.toString()) }, onClick = {
                    selectedText = item.toString()
                    onSelect(item)
                    expanded = false
                })
            }
        }
    }
}
