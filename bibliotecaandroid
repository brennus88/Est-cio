> Para instanciar ViewModels com dependências, criaremos um simples `ViewModelFactory`.

### `viewmodel/ViewModelFactory.kt`
```kotlin
package com.condominio.biblioteca.viewmodel

import androidx.lifecycle.ViewModel
import androidx.lifecycle.ViewModelProvider
import com.condominio.biblioteca.data.repository.LibraryRepository

class ViewModelFactory(private val repo: LibraryRepository) : ViewModelProvider.Factory {
    override fun <T : ViewModel> create(modelClass: Class<T>): T {
        val ctor = when (modelClass) {
            BookViewModel::class.java -> BookViewModel(repo)
            ResidentViewModel::class.java -> ResidentViewModel(repo)
            LoanViewModel::class.java -> LoanViewModel(repo)
            else -> throw IllegalArgumentException("Unknown ViewModel: $modelClass")
        }
        @Suppress("UNCHECKED_CAST")
        return ctor as T
    }
}
```

