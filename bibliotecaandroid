package com.condominio.biblioteca.data.local

import android.content.Context
import androidx.room.Database
import androidx.room.Room
import androidx.room.RoomDatabase
import androidx.room.TypeConverters
import com.condominio.biblioteca.data.model.Book
import com.condominio.biblioteca.data.model.Loan
import com.condominio.biblioteca.data.model.Resident

@Database(entities = [Book::class, Resident::class, Loan::class], version = 1)
@TypeConverters(DateConverters::class)
abstract class AppDatabase : RoomDatabase() {
    abstract fun bookDao(): BookDao
    abstract fun residentDao(): ResidentDao
    abstract fun loanDao(): LoanDao

    companion object {
        @Volatile private var INSTANCE: AppDatabase? = null

        fun getInstance(context: Context): AppDatabase = INSTANCE ?: synchronized(this) {
            INSTANCE ?: Room.databaseBuilder(
                context.applicationContext,
                AppDatabase::class.java,
                "biblioteca.db"
            ).build().also { INSTANCE = it }
        }
    }
}
